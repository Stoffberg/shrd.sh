{
  "name": "shrd",
  "version": "0.1.12",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "pnpm lint:ts && pnpm lint:rust",
    "lint:ts": "pnpm typecheck:core",
    "lint:rust": "cargo fmt --manifest-path cli/Cargo.toml -- --check && cargo clippy --manifest-path cli/Cargo.toml --locked --all-targets -- -D warnings",
    "typecheck": "pnpm typecheck:core",
    "typecheck:core": "pnpm --filter @shrd/api typecheck && pnpm --filter @shrd/db typecheck && pnpm --filter @shrd/sdk typecheck && pnpm --filter @shrd/shared typecheck",
    "test": "pnpm test:unit",
    "test:unit": "pnpm --filter @shrd/api test:unit && cargo test --manifest-path cli/Cargo.toml --locked",
    "test:compat": "pnpm --filter @shrd/api test:compat && cargo check --manifest-path cli/Cargo.toml --locked --no-default-features",
    "test:e2e": "pnpm --filter @shrd/api test:e2e",
    "test:integration": "pnpm --filter @shrd/api test:integration",
    "ci:core": "pnpm lint && pnpm release:check && pnpm test:unit && pnpm test:compat && pnpm --filter @shrd/api build",
    "ci:full": "pnpm ci:core && pnpm test:e2e",
    "deploy": "turbo deploy",
    "db:generate": "pnpm --filter @shrd/db generate",
    "db:migrate": "pnpm --filter @shrd/db migrate",
    "release:check": "node scripts/check-release-versions.mjs"
  },
  "devDependencies": {
    "turbo": "^2.7.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.24.0"
    },
    "neverBuiltDependencies": [
      "sharp"
    ]
  }
}
